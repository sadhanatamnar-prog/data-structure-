#include <iostream>
using namespace std;

struct Student {
    int rollNo;
    string name;
    float marks;
};

int main() {
    Student s[5];

    // Input student records
    for (int i = 0; i < 5; i++) {
        cout << "\nEnter details of Student " << i + 1 << ":\n";

        cout << "Roll No: ";
        cin >> s[i].rollNo;

        cout << "Name: ";
        cin >> s[i].name;

        cout << "Marks: ";
        cin >> s[i].marks;
    }

    // Display student records
    cout << "\n--- Student Records ---\n";

    for (int i = 0; i < 5; i++) {
        cout << "\nRoll No: " << s[i].rollNo;
        cout << "\nName: " << s[i].name;
        cout << "\nMarks: " << s[i].marks << endl;
    }

    return 0;
}